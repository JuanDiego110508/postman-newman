          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 for existing product\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Product object contains correct mandatory fields\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('id', 1);\r",
                  "    pm.expect(jsonData).to.have.property('nombre', 'Laptop Dell Inspiron');\r",
                  "    pm.expect(jsonData).to.have.property('categoria', 'Electrónica');\r",
                  "    pm.expect(jsonData).to.have.property('precio').that.is.a('number');\r",
                  "});"
